# PostgreSQL (Neon, Supabase, ou toute base Postgres)
# En environnement serverless (Vercel), DATABASE_URL DOIT pointer vers
# l'endpoint "pooled" (pgbouncer) — sinon chaque requête ouvre une nouvelle
# connexion TCP/TLS/auth à Postgres, ce qui ralentit fortement chaque clic.
# Sur Neon : dashboard > Connection Details > "Pooled connection" (hostname
# se terminant par -pooler), avec ?pgbouncer=true&connection_limit=1.
DATABASE_URL="postgresql://user:password@host-pooler:5432/dbname?sslmode=require&pgbouncer=true&connection_limit=1"

# Connexion directe (non poolée), utilisée uniquement par Prisma pour les
# migrations (`prisma migrate deploy`). Sur Neon : "Direct connection".
DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# NextAuth / Auth.js
# Générer avec: npx auth secret
AUTH_SECRET="change-me"

# Clé maître de chiffrement pour OrganizationSecret (AES-256-GCM, 32 bytes en base64)
# Générer avec: openssl rand -base64 32
ENCRYPTION_KEY="change-me"

# URL publique de l'application (utilisée pour construire les liens QR code)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
